# Third-party source bodies are not ours to redistribute. refs/LEDGER.md is the
# durable, committed record of what was fetched, verified, and hashed.
refs/*
!refs/LEDGER.md

# LaTeX build artefacts. labbook/main.pdf is the campaign product and IS
# committed; see the negation below.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.pdf
!labbook/main.pdf
# Figures and frozen result records are content, not build artefacts.
!labbook/figures/**
!numerics/**/results/**

# Lane directories are isolated scratch space, not the record. A lane writes
# there; the orchestrator verifies its output and promotes the artifacts that
# survive to their trunk locations (theory/, theory/checks/, theory/verdicts/,
# claims/). Only each lane's SUMMARY.md and PATCH.md are kept, as the durable
# trace of what the lane reported and proposed.
theory/lanes/**
!theory/lanes/**/
!theory/lanes/**/SUMMARY.md
!theory/lanes/**/PATCH.md

# Python
__pycache__/
*.py[cod]

# Julia (not currently used)
.julia/
*.ji
Manifest.toml

# Editor/OS noise
.DS_Store
*~
